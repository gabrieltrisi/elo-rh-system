  createdByUser    User?     @relation("PerformanceEvaluationCreatedByUser", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([companyId])
  @@index([employeeId])
  @@index([periodStart, periodEnd])
  @@index([classification])
}

model PerformancePeerFeedback {
