  createdAt          DateTime            @default(now())

  integration        IntegrationConnection @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  company            Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([integrationId])
  @@index([companyId])
  @@index([status])
  @@index([createdAt])
}

model AuditLog {
