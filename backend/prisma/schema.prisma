generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Company {
  id             Int             @id @default(autoincrement())
  name           String
  cnpj           String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  users          User[]
  employees      Employee[]
  uniformStocks  UniformStock[]
  documents      Document[]
  warnings       Warning[]
  employeeLeaves EmployeeLeave[]
  suspensions    Suspension[]
  benefits       Benefit[]
}

model User {
  id        Int      @id @default(autoincrement())
  name      String?
  email     String   @unique
  password  String
  role      String   @default("ADMIN")
  companyId Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
}

model Employee {
  id             Int              @id @default(autoincrement())
  name           String
  cpf            String
  birthDate      DateTime
  maritalStatus  String
  email          String
  phone          String
  role           String
  department     String
  admissionDate  DateTime
  status         String           @default("ativo")

  shirtSize      String?
  pantsSize      String?
  bootSize       String?

  notes          String?
  companyId      Int
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  company        Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  vacations      Vacation[]
  certificates   Certificate[]
  uniforms       UniformControl[]
  workHours      WorkHour[]
  workSchedules  WorkSchedule[]
  documents      Document[]
  warnings       Warning[]
  employeeLeaves EmployeeLeave[]
  suspensions    Suspension[]
  benefits       Benefit[]

  @@unique([companyId, email])
  @@unique([companyId, cpf])
}

model Vacation {
  id                Int      @id @default(autoincrement())
  employeeId        Int
  acquisitionPeriod String
  startDate         DateTime
  endDate           DateTime
  days              Int
  status            String   @default("PENDENTE")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  employee          Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
}

model Certificate {
  id           Int      @id @default(autoincrement())
  employeeId   Int
  title        String
  startDate    DateTime
  endDate      DateTime
  days         Int
  fileUrl      String?
  status       String   @default("PENDENTE")
  managerNotes String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  employee     Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
}

model UniformControl {
  id           Int      @id @default(autoincrement())
  employeeId   Int
  size         String?
  quantity     Int      @default(1)
  deliveryDate DateTime?
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  employee     Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
}

model UniformStock {
  id                Int      @id @default(autoincrement())
  companyId         Int
  itemName          String
  color             String?
  size              String?
  availableQuantity Int      @default(0)
  minimumQuantity   Int      @default(0)
  notes             String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  company           Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
}

model WorkHour {
  id                Int      @id @default(autoincrement())
  employeeId        Int
  referenceMonth    Int
  referenceYear     Int
  normalHours       Float    @default(0)
  extraHours50      Float    @default(0)
  extraHours100     Float    @default(0)
  nightHours20      Float    @default(0)
  nightExtraHours70 Float    @default(0)
  n52Hours          Float    @default(0)
  totalPaid         Float    @default(0)
  notes             String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  employee          Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, referenceMonth, referenceYear])
  @@index([referenceYear, referenceMonth])
}

model WorkSchedule {
  id              Int      @id @default(autoincrement())
  employeeId      Int
  scheduleType    String
  workModel       String?
  categoryType    String?
  isTrustPosition Boolean  @default(false)
  worksOnHolidays Boolean  @default(false)
  observations    String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  employee        Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
}

model Document {
  id          Int       @id @default(autoincrement())
  title       String
  description String?
  category    String
  fileName    String
  fileUrl     String
  employeeId  Int?
  companyId   Int
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  employee    Employee? @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  company     Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([employeeId])
}

model Warning {
  id          Int      @id @default(autoincrement())
  employeeId  Int
  companyId   Int
  title       String
  type        String
  warningDate DateTime
  status      String   @default("Registrada")
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  employee    Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@index([companyId])
}

model EmployeeLeave {
  id          Int      @id @default(autoincrement())
  employeeId  Int
  companyId   Int
  type        String
  startDate   DateTime
  endDate     DateTime
  status      String   @default("Ativo")
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  employee    Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@index([companyId])
  @@index([status])
}

model Suspension {
  id          Int       @id @default(autoincrement())
  employeeId  Int
  companyId   Int
  title       String
  startDate   DateTime
  endDate     DateTime?
  status      String    @default("Registrada")
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  employee    Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  company     Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@index([companyId])
  @@index([status])
}

model Benefit {
  id                   Int       @id @default(autoincrement())
  employeeId           Int
  companyId            Int
  transportVoucher     Boolean   @default(false)
  transportVoucherType String?
  mealVoucher          Boolean   @default(false)
  mealVoucherType      String?
  healthPlan           Boolean   @default(false)
  dentalPlan           Boolean   @default(false)
  notes                String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  employee             Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  company              Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([employeeId, companyId])
  @@index([employeeId])
  @@index([companyId])
}