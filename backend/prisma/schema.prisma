model WorkSchedule {
  id               Int                     @id @default(autoincrement())
  companyId        Int?
  employeeId       Int?
  createdByUserId  Int?
  specialDateId    Int?
  name             String                  @default("Escala operacional")
  scheduleType     String
  status           String                  @default("RASCUNHO")
  startDate        DateTime?
  endDate          DateTime?
  defaultStartTime String?
  defaultEndTime   String?
  breakMinutes     Int?
  location         String?
  clientName       String?
  workModel        String?
  categoryType     String?
  isTrustPosition  Boolean                 @default(false)
  worksOnHolidays  Boolean                 @default(false)
  observations     String?
  notes            String?
  isDeleted        Boolean                 @default(false)
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt

  company          Company?                @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employee         Employee?               @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  createdByUser    User?                   @relation("WorkScheduleCreatedByUser", fields: [createdByUserId], references: [id], onDelete: SetNull)
  specialDate      WorkSpecialDate?        @relation(fields: [specialDateId], references: [id], onDelete: SetNull)
  assignments      WorkScheduleAssignment[]

  @@index([companyId])
  @@index([employeeId])
  @@index([status])
  @@index([scheduleType])
  @@index([startDate, endDate])
  @@index([specialDateId])
}

model WorkScheduleAssignment {
  id           Int          @id @default(autoincrement())
  scheduleId   Int
  employeeId   Int
  workDate     DateTime
  startTime    String?
  endTime      String?
