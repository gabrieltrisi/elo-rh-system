  updatedAt          DateTime        @updatedAt

  company            Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
}

model StorageObject {
  id                 Int               @id @default(autoincrement())
  companyId          Int
  provider           StorageProvider   @default(LOCAL)
  module             String
  entityType         String
  entityId           Int?
  employeeId         Int?
  uploadedByUserId   Int?
  originalName       String
  storedName         String
  fileName           String
  mimeType           String?
  size               Int?
  path               String?
